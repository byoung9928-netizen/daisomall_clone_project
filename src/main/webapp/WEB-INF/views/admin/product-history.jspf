<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.time.format.DateTimeFormatter,java.util.List,daiso.product.controller.AdminProductChanges.Entry" %>
<%
    List<Entry> productHistory = (List<Entry>) request.getAttribute("productHistory");
    String scopedProductId = (String) request.getAttribute("productHistoryId");
%>
<% if (productHistory != null) {
    DateTimeFormatter changeTime = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
    Map<String, String> historyQuery = (Map<String, String>) request.getAttribute("productHistoryQuery");
    Map<String, String> historyBase = (Map<String, String>) request.getAttribute("productHistoryBase");
    Map<String, String> actionNames = Map.of("CREATE", "등록", "UPDATE", "수정", "BULK_STATUS", "일괄 변경", "DELETE", "삭제", "STOCK_ADJUST", "수동 온라인 재고", "STOCK_RESTORE", "온라인 재고 자동 복구");
%>
    <section class="admin-panel admin-product-history" id="product-history" aria-labelledby="product-history-title">
        <div class="admin-product-history-heading">
            <h2 id="product-history-title">상품 변경 이력</h2>
            <a class="button secondary" href="<%= request.getAttribute("adminProductList") %>">이력 닫기</a>
        </div>
        <form class="inventory-batch-form" data-admin-query-form method="get"
              action="<%= request.getContextPath() %>/app/admin/products#product-history">
            <% for (Map.Entry<String, String> field : historyBase.entrySet()) {
                   if ("page".equals(field.getKey())) continue; %>
                <input type="hidden" name="<%= ProductView.escape(field.getKey()) %>" value="<%= ProductView.escape(field.getValue()) %>">
            <% } %>
            <label class="field">상품명·품번 <input name="historyQuery" type="search" maxlength="120" value="<%= ProductView.escape(historyQuery.get("historyQuery")) %>"></label>
            <label class="field">처리 관리자 <input name="historyActor" maxlength="100" value="<%= ProductView.escape(historyQuery.get("historyActor")) %>"></label>
            <label class="field">주문번호 <input name="historyReference" maxlength="100" value="<%= ProductView.escape(historyQuery.get("historyReference")) %>"></label>
            <label class="field">기간 <select name="historyPeriod">
                <% for (daiso.product.controller.AdminReviewController.Period period : daiso.product.controller.AdminReviewController.Period.values()) { %>
                    <option value="<%= period.name() %>" <%= period.name().equals(historyQuery.get("historyPeriod")) ? "selected" : "" %>><%= period.label %></option>
                <% } %>
            </select></label>
            <label class="field">시작일 <input name="historyStart" type="date" value="<%= ProductView.escape(historyQuery.get("historyStart")) %>"></label>
            <label class="field">종료일 <input name="historyEnd" type="date" value="<%= ProductView.escape(historyQuery.get("historyEnd")) %>"></label>
            <label class="field">재고 유형 <select name="historyType">
                <% for (String[] type : new String[][] {{"", "전체"}, {"RECEIVE", "입고"},{"ISSUE","출고"},{"DAMAGE","파손"},{"COUNT","재고 조사"},
                        {"RETURN","반품 입고"},{"THRESHOLD","부족 기준"},{"ORDER_CANCEL","취소 복구"},{"ORDER_REFUND","환불 복구"}}) { %>
                    <option value="<%= type[0] %>" <%= type[0].equals(historyQuery.get("historyType")) ? "selected" : "" %>><%= type[1] %></option>
                <% } %>
            </select></label>
            <label class="field">이력 정렬 <select name="historyOrder"><option value="">최신순</option>
                <option value="oldest" <%= "oldest".equals(historyQuery.get("historyOrder")) ? "selected" : "" %>>오래된순</option></select></label>
            <button class="button secondary" type="submit">이력 검색</button>
        </form>
        <% if (scopedProductId != null && !scopedProductId.isEmpty()) { %>
            <p>상품 ID <strong><%= ProductView.escape(scopedProductId) %></strong></p>
        <% } %>
        <% if (productHistory.isEmpty()) { %>
            <p>기록된 변경 이력이 없습니다.</p>
        <% } else { %>
            <div class="admin-table-scroll" tabindex="0" role="region" aria-label="상품 변경 이력">
                <table class="admin-table">
                    <caption class="visually-hidden">가격, 재고, 판매 상태 변경 기록</caption>
                    <thead><tr>
                        <th scope="col">변경 시각</th><th scope="col">처리자</th><th scope="col">상품</th>
                        <th scope="col">작업</th><th scope="col">변경 항목</th>
                    </tr></thead>
                    <tbody>
                        <% for (Entry change : productHistory) { %>
                            <tr>
                                <td><time datetime="<%= change.at %>"><%= change.at.format(changeTime) %></time></td>
                                <td><%= change.orderNo == null ? ProductView.escape(change.actor) : "시스템" %></td>
                                <td><%= ProductView.escape(change.productName) %> (<%= ProductView.escape(change.productCode) %>)</td>
                                <td><%= ProductView.escape(actionNames.get(change.action)) %></td>
                                <td>
                                    <ul class="admin-product-history-differences">
                                        <% if (change.priceChanged()) { %>
                                            <li><strong>가격</strong> <%= change.beforePrice == null ? "—" : ProductView.money(change.beforePrice) %> → <%= change.afterPrice == null ? "—" : ProductView.money(change.afterPrice) %></li>
                                        <% } %>
                                        <% if (change.stockChanged()) { %>
                                            <li><strong>재고</strong> <%= change.beforeStock == null ? "—" : change.beforeStock %> → <%= change.afterStock == null ? "—" : change.afterStock %></li>
                                        <% } %>
                                        <% if (change.orderNo != null) { %>
                                            <li><strong>주문번호</strong> <%= ProductView.escape(change.orderNo) %></li>
                                            <li><strong>복구 수량</strong> +<%= change.afterStock - change.beforeStock %>개</li>
                                            <li><strong>사유</strong> <%= ProductView.escape(change.stockReason) %></li>
                                        <% } else if (change.stockOperation != null) { %>
                                            <% int delta = change.afterStock - change.beforeStock; %>
                                            <li><strong>유형</strong> <%= daiso.product.controller.OnlineInventoryController.operationLabel(daiso.product.dao.StoreInventoryDAO.Change.valueOf(change.stockOperation)) %> · <%= delta > 0 ? "+" : "" %><%= delta %>개</li>
                                            <li><strong>사유</strong> <%= ProductView.escape(change.stockReason) %></li>
                                        <% } %>
                                        <% if (change.beforeThreshold != null) { %>
                                            <li><strong>부족 기준</strong> <%= change.beforeThreshold %>개 이하 → <%= change.afterThreshold %>개 이하
                                                · <%= ProductView.escape(change.thresholdReason) %></li>
                                        <% } %>
                                        <% if (change.beforeCategory != null || change.afterCategory != null) { %>
                                            <li><strong>카테고리</strong> <%= ProductView.escape(change.beforeCategory) %> → <%= ProductView.escape(change.afterCategory) %></li>
                                        <% } %>
                                        <% if (change.statusChanged()) { %>
                                            <li><strong>판매 상태</strong> <%= change.beforeStatus == null ? "—" : ProductView.escape(statuses.getOrDefault(change.beforeStatus, change.beforeStatus)) %> → <%= change.afterStatus == null ? "—" : ProductView.escape(statuses.getOrDefault(change.afterStatus, change.afterStatus)) %></li>
                                        <% } %>
                                    </ul>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>
        <% daiso.product.controller.InventoryPagination inventoryPagination =
                   (daiso.product.controller.InventoryPagination) request.getAttribute("productHistoryPagination");
           if (inventoryPagination.pages > 1) {
               request.setAttribute("adminPaginationLabel", "상품 변경 이력 페이지"); %>
            <%@ include file="inventory-pagination.jspf" %>
        <% } %>
    </section>
<% } %>
