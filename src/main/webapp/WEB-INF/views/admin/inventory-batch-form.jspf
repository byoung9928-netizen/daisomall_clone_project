<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.util.List" %>
<section class="admin-panel inventory-batch-panel" id="inventory-batch" aria-labelledby="inventory-batch-title" data-batch-panel>
    <header class="inventory-batch-heading">
        <h3 id="inventory-batch-title">재고 일괄 작업</h3>
        <span data-batch-count aria-live="polite"></span>
        <button type="button" class="button secondary" data-batch-clear hidden>선택 해제</button>
    </header>
    <form id="inventory-batch-form" method="post" data-batch-form
          action="<%= ProductView.escape(request.getContextPath() + (storeBatch ? "/app/admin/stores/batch" : "/app/admin/inventory/batch")) %>">
        <input type="hidden" name="csrf" value="<%= ProductView.escape(batchCsrf) %>">
        <% for (Map.Entry<String, String> field : batchFilters.entrySet()) { %>
            <input type="hidden" name="<%= ProductView.escape(field.getKey()) %>" value="<%= ProductView.escape(field.getValue()) %>">
        <% } %>
        <div class="inventory-batch-fields">
            <label class="field">변경 유형
                <select name="operation">
                    <option value="RECEIVE">입고</option>
                    <option value="ISSUE">출고</option>
                    <option value="THRESHOLD">부족 기준 변경</option>
                    <% if (storeBatch) { %><option value="TRANSFER">매장 간 이동</option><% } %>
                </select>
            </label>
            <% if (storeBatch) { %>
                <div class="field" data-batch-source hidden><span>출고 매장</span><strong><%= ProductView.escape(batchStoreName) %></strong></div>
                <label class="field" data-batch-destination>입고 매장
                    <select name="destination">
                        <option value="">입고 매장 선택</option>
                        <% for (daiso.product.dao.StoreInventoryDAO.Location location :
                                (List<daiso.product.dao.StoreInventoryDAO.Location>) request.getAttribute("inventoryBatchLocations")) {
                            if (location.id.equals(batchFilters.get("store"))) continue; %>
                            <option value="<%= ProductView.escape(location.id) %>"><%= ProductView.escape(location.name) %></option>
                        <% } %>
                    </select>
                </label>
            <% } %>
            <label class="field" data-batch-mode hidden>입력 방식
                <select name="amountMode">
                    <option value="SHARED">동일 수량 적용</option>
                    <option value="INDIVIDUAL">상품별 직접 입력</option>
                </select>
            </label>
            <label class="field" data-batch-shared><span data-batch-amount-label>입고 수량</span>
                <input name="amount" type="number" inputmode="numeric" min="1" max="2147483647" step="1" required aria-describedby="inventory-batch-hint">
            </label>
            <label class="field"><span data-batch-reason-label>변경 사유</span>
                <input name="reason" maxlength="255" required>
            </label>
        </div>
        <p id="inventory-batch-hint" class="store-stock-hint" data-batch-hint>선택한 상품에 동일한 수량을 입고합니다.</p>
        <div data-batch-individual hidden></div>
        <p data-batch-error class="error-message" role="alert" tabindex="-1" hidden></p>
        <p class="store-stock-hint">검색 조건, 페이지 또는 매장을 바꾸면 현재 선택과 입력값이 초기화됩니다.</p>
        <noscript><p class="store-stock-hint">변경 유형에 맞는 수량이나 새 부족 기준을 입력하세요. 선택한 상품에 같은 값이 적용됩니다.</p></noscript>
        <button class="button primary" type="submit">미리보기</button>
    </form>
    <dialog class="inventory-batch-dialog" data-batch-dialog aria-labelledby="batch-preview-title"></dialog>
</section>
