<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.time.format.DateTimeFormatter,daiso.product.dto.ProductReview,daiso.product.dto.ReviewFeedback.Reaction,daiso.product.dto.ReviewFeedback.Tally,daiso.product.dto.ReviewExtras.Answer" %>
<% DateTimeFormatter reviewDate = DateTimeFormatter.ISO_LOCAL_DATE; %>
<div class="pd-reviews__results" data-review-results
     data-review-product="<%= ProductView.escape(product.getProductId()) %>"
     data-review-sort="<%= ProductView.escape(selectedReviewSort) %>"
     data-feedback-csrf="<%= ProductView.escape(request.getAttribute("detailReviewCsrf")) %>"
     data-review-page="<%= detailReviews.page %>" tabindex="-1">
    <% if (detailReviews.items.isEmpty()) { %>
        <p class="pd-reviews__empty">아직 등록된 리뷰가 없습니다.</p>
    <% } else { %>
        <ul class="pd-reviews__list">
            <% for (ProductReview review : detailReviews.items) { %>
                <li class="pd-reviews__item" data-feedback-review="<%= review.id %>">
                    <div class="pd-reviews__meta">
                        <span class="pd-reviews__stars" aria-label="별점 <%= review.rating %>점">
                            <span aria-hidden="true"><%= "★".repeat(review.rating) %><span class="pd-reviews__stars-empty"><%= "★".repeat(5 - review.rating) %></span></span>
                        </span>
                        <span class="pd-reviews__author"><%= ProductView.escape(review.authorLabel) %></span>
                        <div class="pd-review-date-actions">
                            <time datetime="<%= review.createdAt %>"><%= review.createdAt.format(reviewDate) %></time>
                            <% if (detailReviews.feedback.reportsAvailable && !review.owner) { %>
                                <button type="button" data-review-report>신고</button>
                            <% } %>
                        </div>
                    </div>
                    <% if (!detailReviews.extras.answers(review.id).isEmpty()) { %>
                        <dl class="pd-reviews__answers">
                            <% for (Answer answer : detailReviews.extras.answers(review.id)) { %>
                                <div><dt><%= ProductView.escape(answer.question) %></dt><dd><%= ProductView.escape(answer.label) %></dd></div>
                            <% } %>
                        </dl>
                    <% } %>
                    <p class="pd-reviews__body">
                        <span class="pd-reviews__badge<%= review.refunded ? " pd-reviews__badge--refunded" : "" %>"><%= review.refunded ? "환불한 구매자" : "구매 인증" %></span>
                        <span><%= ProductView.escape(review.content) %></span>
                    </p>
                    <% if (!detailReviews.extras.photos(review.id).isEmpty()) { %>
                        <div class="pd-reviews__photos">
                            <% int number = 1;
                               for (long photoId : detailReviews.extras.photos(review.id)) {
                                   String photoUrl = ProductView.url(context, "/product-review-photo", Map.of("id", Long.toString(photoId)));
                            %>
                                <a href="<%= photoUrl %>"><img src="<%= photoUrl %>" loading="lazy"
                                    alt="리뷰 사진 <%= number++ %> 크게 보기" width="80" height="80"></a>
                            <% } %>
                        </div>
                    <% } %>
                    <% if (detailReviews.feedback.reactionsAvailable) { %>
                        <div class="pd-review-reactions" role="group" aria-label="리뷰 반응">
                            <% for (Reaction reaction : Reaction.values()) {
                                   Tally tally = detailReviews.feedback.tally(review.id, reaction); %>
                                <button type="button" data-review-reaction="<%= reaction.name() %>"
                                        aria-pressed="<%= tally.selected %>" <%= review.owner ? "disabled" : "" %>>
                                    <span aria-hidden="true"><%= reaction.icon %></span>
                                    <%= reaction.label %><span class="pd-review-reaction-count" data-reaction-count <%= tally.count == 0 ? "hidden" : "" %>><%= tally.count == 0 ? "" : Long.toString(tally.count) %></span>
                                </button>
                            <% } %>
                        </div>
                    <% } %>
                    <p class="pd-review-feedback-error" data-feedback-error role="status" hidden></p>
                </li>
            <% } %>
        </ul>
        <% if (detailReviews.totalPages > 1) { %>
            <nav class="pd-reviews__pagination" aria-label="상품 리뷰 페이지">
                <% if (detailReviews.page > 1) { %>
                    <a rel="prev" data-review-page-link="<%= detailReviews.page - 1 %>" href="<%= ProductView.url(context, "/product.jsp", Map.of("id", product.getProductId(), "reviewSort", selectedReviewSort, "reviewPage", Integer.toString(detailReviews.page - 1))) %>#product-reviews">이전</a>
                <% } %>
                <span aria-current="page"><%= detailReviews.page %> / <%= detailReviews.totalPages %></span>
                <% if (detailReviews.page < detailReviews.totalPages && detailReviews.page < Integer.MAX_VALUE) { %>
                    <a rel="next" data-review-page-link="<%= detailReviews.page + 1 %>" href="<%= ProductView.url(context, "/product.jsp", Map.of("id", product.getProductId(), "reviewSort", selectedReviewSort, "reviewPage", Integer.toString(detailReviews.page + 1))) %>#product-reviews">다음</a>
                <% } %>
            </nav>
        <% } %>
    <% } %>
</div>
