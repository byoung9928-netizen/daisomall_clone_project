<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.text.NumberFormat,daiso.product.dto.ReviewExtras.Distribution,daiso.product.dto.ReviewExtras.Gallery,daiso.product.dto.ReviewFeedback.Reason" %>
<section id="product-reviews" class="pd-reviews" aria-labelledby="product-reviews-title"
         data-reaction-url="<%= ProductView.escape(context + "/app/products/reviews/reaction") %>"
         data-report-url="<%= ProductView.escape(context + "/app/products/reviews/report") %>"
         data-feedback-login="<%= ProductView.escape(context + "/app/member/login") %>"
         data-review-endpoint="<%= ProductView.escape(context + "/app/products/detail/reviews") %>">
    <header class="pd-reviews__heading">
        <h2 id="product-reviews-title">리뷰</h2>
    </header>
    <% if (detailReviews == null) { %>
        <p class="pd-reviews__empty">리뷰를 불러오지 못했습니다. 잠시 후 다시 확인해 주세요.</p>
    <% } else {
           String selectedReviewSort = (String) request.getAttribute("detailReviewSort");
           Gallery reviewGallery = detailReviews.extras.gallery;
           NumberFormat reviewNumbers = NumberFormat.getIntegerInstance(java.util.Locale.KOREA);
    %>
        <div class="pd-reviews__summary">
            <% if (detailReviews.total == 0) { %>
                <p class="pd-reviews__empty">아직 등록된 리뷰가 없습니다.</p>
            <% } else { %>
                <div class="pd-reviews__score">
                    <span class="pd-reviews__score-stars" aria-hidden="true"><span>★★★★★</span><span style="--score-width: <%= detailReviews.average.multiply(java.math.BigDecimal.valueOf(20)).intValue() %>%">★★★★★</span></span>
                    <strong aria-label="평균 평점 5점 만점에 <%= detailAverage %>점"><%= detailAverage %></strong>
                    <span class="pd-reviews__count">리뷰 <%= reviewNumbers.format(detailReviews.total) %>개</span>
                </div>
                <% if (!detailReviews.extras.distributions.isEmpty()) { %>
                    <div class="pd-reviews__distributions" aria-label="리뷰 상세 평가">
                        <% for (Distribution distribution : detailReviews.extras.distributions) { %>
                            <section class="pd-reviews__distribution">
                                <h3><%= ProductView.escape(distribution.question.label) %></h3>
                                <p class="pd-reviews__responses">응답 <%= reviewNumbers.format(distribution.responses) %>건</p>
                                <% for (int reviewOption = 0; reviewOption < distribution.percentages.size(); reviewOption++) {
                                       int percent = distribution.percentages.get(reviewOption);
                                %>
                                    <div class="pd-reviews__option">
                                        <span><%= ProductView.escape(distribution.question.options.get(reviewOption)) %></span>
                                        <div class="pd-reviews__bar" aria-hidden="true"><span style="--answer-width: <%= percent %>%"></span></div>
                                        <strong><%= percent %>%</strong>
                                    </div>
                                <% } %>
                            </section>
                        <% } %>
                    </div>
                <% } %>
            <% } %>
        </div>
        <% if (!reviewGallery.ids.isEmpty()) { %>
            <section class="pd-reviews__gallery" id="product-review-photos" aria-labelledby="review-photo-title">
                <header>
                    <h3 id="review-photo-title">리뷰 사진 <span><%= reviewNumbers.format(reviewGallery.total) %>장</span></h3>
                    <% if (reviewGallery.pages > 1) { %>
                        <nav class="pd-reviews__gallery-nav" aria-label="리뷰 사진 페이지">
                            <% if (reviewGallery.page > 1) { %>
                                <a href="<%= ProductView.url(context, "/product.jsp", Map.of("id", product.getProductId(), "reviewSort", selectedReviewSort, "reviewPage", Integer.toString(detailReviews.page), "photoPage", Integer.toString(reviewGallery.page - 1))) %>#product-review-photos">이전 사진</a>
                            <% } %>
                            <% if (reviewGallery.page < reviewGallery.pages && reviewGallery.page < Integer.MAX_VALUE) { %>
                                <a href="<%= ProductView.url(context, "/product.jsp", Map.of("id", product.getProductId(), "reviewSort", selectedReviewSort, "reviewPage", Integer.toString(detailReviews.page), "photoPage", Integer.toString(reviewGallery.page + 1))) %>#product-review-photos"><%= reviewGallery.page == 1 ? "사진 더 보기" : "다음 사진" %></a>
                            <% } %>
                        </nav>
                    <% } %>
                </header>
                <div class="pd-reviews__gallery-photos">
                    <% long galleryIndex = (reviewGallery.page - 1L) * 8 + 1;
                       for (long photoId : reviewGallery.ids) {
                           String galleryPhoto = ProductView.url(context, "/product-review-photo", Map.of("id", Long.toString(photoId)));
                    %>
                        <a href="<%= galleryPhoto %>"><img src="<%= galleryPhoto %>" loading="lazy"
                            width="90" height="90" alt="리뷰 사진 <%= galleryIndex++ %> 크게 보기"></a>
                    <% } %>
                </div>
            </section>
        <% } %>
        <% if (!detailReviews.items.isEmpty()) { %>
            <nav class="pd-reviews__toolbar" aria-label="리뷰 정렬">
                <%
                    String[] reviewSorts = {"newest", "highest", "lowest"};
                    String[] reviewSortLabels = {"최신순", "별점 높은순", "별점 낮은순"};
                    for (int ri = 0; ri < reviewSorts.length; ri++) {
                        String reviewSortKey = reviewSorts[ri];
                %>
                    <a data-review-sort-link="<%= reviewSortKey %>"
                       href="<%= ProductView.url(context, "/product.jsp", Map.of("id", product.getProductId(), "reviewSort", reviewSortKey, "photoPage", Integer.toString(reviewGallery.page))) %>#product-reviews"
                       <%= reviewSortKey.equals(selectedReviewSort) ? "aria-current=\"true\"" : "" %>><%= reviewSortLabels[ri] %></a>
                <% } %>
            </nav>
            <p class="pd-reviews__status" role="status" data-review-status></p>
            <%@ include file="detail-review-results.jspf" %>
        <% } %>
    <% } %>
    <% if (detailReviews != null && detailReviews.feedback.reportsAvailable && !detailReviews.items.isEmpty()) { %>
        <dialog class="pd-review-dialog" data-report-dialog aria-labelledby="review-report-title">
            <form data-report-form>
                <header>
                    <h3 id="review-report-title">신고하기</h3>
                    <button type="button" data-report-close aria-label="신고 창 닫기">×</button>
                </header>
                <fieldset>
                    <legend class="visually-hidden">신고 사유</legend>
                    <% for (Reason reason : Reason.values()) { %>
                        <label><input type="radio" name="reason" value="<%= reason.name() %>" required
                            <%= reason == Reason.OFF_TOPIC ? "checked" : "" %>> <%= reason.label %></label>
                    <% } %>
                </fieldset>
                <p class="pd-review-dialog-note">신고는 반대 의견을 표시하는 기능이 아닙니다.</p>
                <p class="pd-review-feedback-error" data-report-error role="alert" hidden></p>
                <footer>
                    <button type="button" data-report-close>취소</button>
                    <button type="submit" class="pd-report-primary">신고하기</button>
                </footer>
            </form>
        </dialog>
        <dialog class="pd-review-dialog pd-review-dialog--complete" data-report-complete aria-labelledby="review-report-complete-title">
            <form method="dialog">
                <h3 id="review-report-complete-title">신고가 접수되었습니다.</h3>
                <p>소중한 의견에 감사드립니다.</p>
                <footer><button class="pd-report-primary" autofocus>확인</button></footer>
            </form>
        </dialog>
    <% } %>
</section>
