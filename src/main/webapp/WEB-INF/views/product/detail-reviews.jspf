<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.time.format.DateTimeFormatter,daiso.product.dto.ProductReview,daiso.product.dto.ReviewExtras.Answer" %>
<section id="product-reviews" class="pd-reviews" aria-labelledby="product-reviews-title" tabindex="-1">
    <div class="pd-reviews__heading">
        <h2 id="product-reviews-title">상품 리뷰<%= detailReviews == null ? "" : " (" + detailReviews.total + ")" %></h2>
    </div>
    <% if (detailReviews == null) { %>
        <p class="pd-reviews__empty">리뷰를 불러오지 못했습니다. 잠시 후 다시 확인해 주세요.</p>
    <% } else { %>
        <div class="pd-reviews__summary">
            <span class="pd-reviews__star" aria-hidden="true">★</span>
            <div>
                <strong><%= detailReviews.average == null ? "아직 평점이 없어요" : detailAverage + " / 5" %></strong>
                <p>구매 인증 리뷰 <%= detailReviews.total %>개</p>
            </div>
        </div>
        <% if (detailReviews.items.isEmpty()) { %>
            <p class="pd-reviews__empty">아직 등록된 리뷰가 없습니다.</p>
        <% } else { %>
            <% String selectedReviewSort = (String) request.getAttribute("detailReviewSort"); %>
            <form class="pd-reviews__toolbar" method="get" action="<%= ProductView.escape(context + "/product.jsp") %>#product-reviews">
                <input type="hidden" name="id" value="<%= ProductView.escape(product.getProductId()) %>">
                <label for="product-review-sort">리뷰 정렬</label>
                <select id="product-review-sort" name="reviewSort">
                    <option value="newest" <%= "newest".equals(selectedReviewSort) ? "selected" : "" %>>최신순</option>
                    <option value="highest" <%= "highest".equals(selectedReviewSort) ? "selected" : "" %>>별점 높은순</option>
                    <option value="lowest" <%= "lowest".equals(selectedReviewSort) ? "selected" : "" %>>별점 낮은순</option>
                </select>
                <button type="submit" class="button secondary">적용</button>
            </form>
            <% DateTimeFormatter reviewDate = DateTimeFormatter.ofPattern("yyyy.MM.dd"); %>
            <ul class="pd-reviews__list">
                <% for (ProductReview review : detailReviews.items) { %>
                    <li class="pd-reviews__item">
                        <div class="pd-reviews__meta">
                            <span class="pd-reviews__stars" aria-label="별점 <%= review.rating %>점">
                                <span aria-hidden="true"><%= "★".repeat(review.rating) %><span class="pd-reviews__stars-empty"><%= "★".repeat(5 - review.rating) %></span></span>
                            </span>
                            <span class="pd-reviews__badge">구매 인증</span>
                            <time datetime="<%= review.createdAt %>"><%= review.createdAt.format(reviewDate) %></time>
                        </div>
                        <p class="pd-reviews__body"><%= ProductView.escape(review.content) %></p>
                        <% if (!detailReviews.extras.answers(review.id).isEmpty()) { %>
                            <dl class="pd-reviews__answers">
                                <% for (Answer answer : detailReviews.extras.answers(review.id)) { %>
                                    <div><dt><%= ProductView.escape(answer.question) %></dt><dd><%= ProductView.escape(answer.label) %></dd></div>
                                <% } %>
                            </dl>
                        <% } %>
                        <% if (!detailReviews.extras.photos(review.id).isEmpty()) { %>
                            <div class="pd-reviews__photos">
                                <% int number = 1;
                                   for (long photoId : detailReviews.extras.photos(review.id)) {
                                       String photoUrl = ProductView.escape(context + "/product-review-photo?id=" + photoId);
                                %>
                                    <a href="<%= photoUrl %>"><img src="<%= photoUrl %>" loading="lazy"
                                         alt="리뷰 사진 <%= number++ %> 크게 보기" width="96" height="96"></a>
                                <% } %>
                            </div>
                        <% } %>
                    </li>
                <% } %>
            </ul>
            <% if (detailReviews.totalPages > 1) { %>
                <nav class="pd-reviews__pagination" aria-label="상품 리뷰 페이지">
                    <% if (detailReviews.page > 1) { %>
                        <a rel="prev" class="button secondary" href="<%= ProductView.url(context, "/product.jsp", Map.of("id", product.getProductId(), "reviewSort", selectedReviewSort, "reviewPage", Integer.toString(detailReviews.page - 1))) %>#product-reviews">이전</a>
                    <% } %>
                    <span aria-current="page"><%= detailReviews.page %> / <%= detailReviews.totalPages %></span>
                    <% if (detailReviews.page < detailReviews.totalPages && detailReviews.page < Integer.MAX_VALUE) { %>
                        <a rel="next" class="button secondary" href="<%= ProductView.url(context, "/product.jsp", Map.of("id", product.getProductId(), "reviewSort", selectedReviewSort, "reviewPage", Integer.toString(detailReviews.page + 1))) %>#product-reviews">다음</a>
                    <% } %>
                </nav>
            <% } %>
        <% } %>
    <% } %>
</section>
