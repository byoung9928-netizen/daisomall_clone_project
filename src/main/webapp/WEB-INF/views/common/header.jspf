<%@ page pageEncoding="UTF-8" %>
<%@ page import="daiso.product.controller.ProductView" %>
<header class="site-header">
    <div class="announcement">
        <div class="container announcement-inner">
            <span>새로 들어온 신상, 지금 확인하세요</span>
            <div class="store-tools">
                <a href="${pageContext.request.contextPath}/app/stores/locations">매장 위치 찾기</a>
                <a class="store-search-link" href="${pageContext.request.contextPath}/app/stores/products">매장 상품 찾기</a>
				<%
				if ("ADMIN".equalsIgnoreCase(String.valueOf(session.getAttribute("role")))) {
				%>
				<a href="${pageContext.request.contextPath}/app/admin/dashboard"
					style="display: flex; align-items: center; white-space: nowrap; color: #e60023; font-size: 13px; font-weight: 600; text-decoration: none;"
					title="관리자 대시보드로 이동"> 관리자 대시보드 </a>
				<%
				}
				%>
			</div>
        </div>
    </div>
    <div class="container header-main">
        <a class="brand" href="${pageContext.request.contextPath}/" aria-label="다이소몰 클론 홈">
            <img src="${pageContext.request.contextPath}/assets/images/home/daiso-logo.svg" alt="" width="136" height="33">
        </a>
        <form class="search-form" method="get" action="${pageContext.request.contextPath}/search.jsp" role="search" aria-label="상품 검색">
            <% if ("store".equals(request.getParameter("collection"))) { %>
                <input type="hidden" name="collection" value="store">
            <% } %>
            <label class="visually-hidden" for="search-query">검색어</label>
            <input id="search-query" type="search" name="q" maxlength="100" autocomplete="off" value="<%= daiso.product.controller.ProductView.escape(request.getParameter("q")) %>" placeholder="상품명, 품번, 브랜드 검색">
            <button type="submit" aria-label="검색"><span class="search-icon" aria-hidden="true"></span></button>
        </form>
		<div class="header-service-tools">
			<button id="open-ai-chat" class="ai-chat-trigger" type="button"
				aria-haspopup="dialog" aria-controls="ai-chat-dialog">
				<span aria-hidden="true">✦</span> AI 챗봇
			</button>
			<button class="delivery-button" type="button" data-unavailable>
				<img class="delivery-icon"
					src="${pageContext.request.contextPath}/assets/images/home/service-parcel.svg"
					alt="" width="16" height="16"> 배송이나 픽업 어때요? <span
					aria-hidden="true">⌄</span>
			</button>
		</div>
		<div class="account-tools" aria-label="회원 메뉴">
			<%
			if (session.getAttribute("member_id") == null) {
			%>
    <button type="button" title="로그인"
            onclick="location.href='${pageContext.request.contextPath}/app/member/login'">
        <svg class="account-icon" aria-hidden="true">
            <use href="${pageContext.request.contextPath}/assets/images/icons.svg#login" />
        </svg>
        <span class="account-label">로그인·회원</span>
    </button>
<% } else { %>
    <form method="post"
          action="${pageContext.request.contextPath}/app/member/logout"
          style="display: contents;">
        <button type="submit" title="로그아웃">
            <svg class="account-icon" aria-hidden="true">
                <use href="${pageContext.request.contextPath}/assets/images/icons.svg#login" />
            </svg>
            <span class="account-label">로그아웃</span>
        </button>
    </form>
<% } %>
            <button type="button" title="마이페이지" onclick="location.href='${pageContext.request.contextPath}/app/member/mypage'">
                <svg class="account-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/assets/images/icons.svg#user" /></svg>
                <span class="account-label">마이페이지</span>
            </button>
            <a class="account-wishlist-link" href="${pageContext.request.contextPath}/app/order/mypage?productActivity=wishlist" title="찜한 상품">
                <svg class="account-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/assets/images/icons.svg#heart" /></svg>
                <span class="account-label">찜한 상품</span>
            </a>
            <button type="button" title="장바구니" data-shopping-route="cart" data-unavailable>
                <svg class="account-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/assets/images/icons.svg#bag" /></svg>
                <span class="account-label">장바구니</span>
            </button>
        </div>
    </div>
</header>
<dialog id="ai-chat-dialog" class="ai-chat-dialog" aria-labelledby="ai-chat-title">
    <div class="ai-chat-heading">
        <h2 id="ai-chat-title">AI 챗봇</h2>
        <form method="dialog">
            <button type="submit" class="ai-chat-close" aria-label="채팅 닫기">×</button>
        </form>
    </div>

    <% if (session.getAttribute("member_id") != null) { %>
        <div id="ai-chat-log" class="ai-chat-log" role="log" aria-label="대화 내역">
            <p class="ai-chat-bubble">안녕하세요! 궁금한 걸 물어보세요. 매장 재고도 찾아드려요.</p>
        </div>
        <p id="ai-chat-status" class="visually-hidden" role="status"></p>
        <form id="ai-chat-form" class="ai-chat-form" method="post"
              action="${pageContext.request.contextPath}/app/stores/chat">
            <label for="ai-chat-question" class="visually-hidden">질문 입력</label>
            <input id="ai-chat-question" name="question" type="text"
                   maxlength="200" required placeholder="무엇이 궁금한가요?">
            <button type="submit">보내기</button>
        </form>
    <% } else { %>
        <a class="ai-chat-login" href="${pageContext.request.contextPath}/app/member/login">
            로그인하고 대화하기
        </a>
    <% } %>
</dialog>
<script src="${pageContext.request.contextPath}/assets/js/common/ai-chat.js" defer></script>
<p id="common-feature-status" class="feature-status" role="status" aria-live="polite"></p>
