<%@ page pageEncoding="UTF-8" %>
<%@ page import="daiso.product.controller.ProductView" %>
<%
    Object navigationValue = request.getAttribute("activeNavigation");
    String navigationKey = navigationValue instanceof String ? (String) navigationValue : "";
    if (!navigationKey.matches("[a-z-]+")) {
        navigationKey = "";
    }
%>
<div class="navigation-shell">
    <nav class="container main-navigation" aria-label="주요 메뉴" data-active-navigation="<%= navigationKey %>">
        <button id="category-toggle" class="category-toggle" type="button" aria-expanded="false" aria-controls="category-panel">
            <span class="menu-icon" aria-hidden="true"></span> <span>카테고리</span>
        </button>
        <div class="navigation-links">
            <a class="brand-menu" data-navigation-key="brand" href="${pageContext.request.contextPath}/list.jsp?collection=brand">브랜드</a>
            <button class="season-link" type="button" data-navigation-key="season" data-unavailable>겨울 시즌템</button>
            <a data-navigation-key="home" href="${pageContext.request.contextPath}/">홈</a>
            <a data-navigation-key="new" href="${pageContext.request.contextPath}/app/products?collection=new">신상발견</a>
            <a data-navigation-key="open-run" href="${pageContext.request.contextPath}/app/products?collection=open-run">오픈런</a>
            <a data-navigation-key="exhibitions" href="${pageContext.request.contextPath}/app/products?collection=exhibitions">기획전</a>
            <a data-navigation-key="ranking" href="${pageContext.request.contextPath}/app/products?collection=ranking">랭킹</a>
            <a data-navigation-key="rating" href="${pageContext.request.contextPath}/app/products?collection=rating">별점5점</a>
            <a data-navigation-key="selling-out" href="${pageContext.request.contextPath}/app/products/selling-out"
               <%= "selling-out".equals(navigationKey) ? "aria-current=\"page\"" : "" %>>품절임박</a>
            <a data-navigation-key="beauty" href="${pageContext.request.contextPath}/app/products?collection=beauty">뷰티</a>
            <a data-navigation-key="health" href="${pageContext.request.contextPath}/app/products?collection=health">건강식품</a>
        </div>
        <div class="delivery-links">
            <button type="button" data-navigation-key="pickup" data-unavailable><img class="delivery-icon" src="${pageContext.request.contextPath}/assets/images/home/service-pickup.svg" alt="" width="16" height="16">매장픽업</button>
            <button type="button" data-navigation-key="today-delivery" data-unavailable><img class="delivery-icon" src="${pageContext.request.contextPath}/assets/images/home/service-today.svg" alt="" width="16" height="16">오늘배송</button>
            <button type="button" data-navigation-key="bulk-order" data-unavailable><img class="delivery-icon" src="${pageContext.request.contextPath}/assets/images/home/service-bulk.svg" alt="" width="16" height="16">대량주문</button>
        </div>
    </nav>
    <% Object productNavigation = request.getAttribute("productCategories");
       if (productNavigation instanceof java.util.List<?>) { %>
        <template id="product-category-data">
            <% for (Object entry : (java.util.List<?>) productNavigation) {
                   daiso.product.controller.ProductDAO.Category node = (daiso.product.controller.ProductDAO.Category) entry; %>
                <span data-id="<%= daiso.product.controller.ProductView.escape(node.id) %>"
                      data-parent-id="<%= daiso.product.controller.ProductView.escape(node.parentId) %>"
                      data-level="<%= node.level %>" data-display-order="<%= node.displayOrder %>"><%= daiso.product.controller.ProductView.escape(node.name) %></span>
            <% } %>
        </template>
    <% } %>
    <div class="container category-anchor">
        <section id="category-panel" class="category-panel" aria-label="전체 카테고리 탐색" data-source="${pageContext.request.contextPath}/assets/mock/categories.json" hidden>
            <div class="category-heading">
                <button id="category-close" class="category-close" type="button" aria-label="카테고리 닫기">
                    <span aria-hidden="true"></span>
                </button>
            </div>
            <p id="category-load-status" class="category-load-status" role="status">카테고리를 불러오는 중입니다.</p>
            <button id="category-retry" type="button" hidden>다시 불러오기</button>
            <div class="category-columns">
                <section class="category-column" aria-labelledby="category-level-one">
                    <h2 id="category-level-one" class="visually-hidden">대분류</h2>
                    <ul id="category-roots"></ul>
                </section>
                <section class="category-column" aria-labelledby="category-level-two">
                    <h2 id="category-level-two" class="visually-hidden">중분류</h2>
                    <ul id="category-children"></ul>
                </section>
                <section class="category-column" aria-labelledby="category-level-three">
                    <h2 id="category-level-three" class="visually-hidden">소분류</h2>
                    <ul id="category-leaves"></ul>
                </section>
            </div>
            <p id="common-category-selection" class="visually-hidden" role="status">아직 선택한 카테고리가 없습니다.</p>
        </section>
    </div>
</div>
