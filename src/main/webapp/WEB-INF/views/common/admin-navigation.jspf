<%@ page pageEncoding="UTF-8" %>
<%
    String[][] adminMenu = {
        {"dashboard", "대시보드"}, {"categories", "카테고리 관리"}, {"products", "상품 관리"},
        {"inventory", "온라인 재고"}, {"stores", "매장별 재고"}, {"orders", "주문 관리"}, {"users", "사용자 관리"}
    };
%>
<nav class="admin-sidebar" aria-label="관리 메뉴">
        <% for (String[] entry : adminMenu) {
        String adminHref = "users".equals(entry[0])
                ? request.getContextPath() + "/app/admin/users"
                : request.getContextPath() + "/admin/?view=" + entry[0];
    %>
        <a href="<%= adminHref %>" data-admin-link="<%= entry[0] %>"<% if (entry[0].equals(request.getAttribute("adminSection"))) { %> aria-current="page"<% } %>><%= entry[1] %></a>
        <% if ("products".equals(entry[0]) && ("products".equals(request.getAttribute("adminSection"))
                || "product-reviews".equals(request.getAttribute("adminSection")))) { %>
            <a class="admin-sidebar-subitem" href="${pageContext.request.contextPath}/app/admin/products/reviews"
               <% if ("product-reviews".equals(request.getAttribute("adminSection"))) { %>aria-current="page"<% } %>>리뷰 관리</a>
        <% } %>
    <% } %>
    <a href="${pageContext.request.contextPath}/app/admin/sales"
       <% if ("sales".equals(request.getAttribute("adminSection"))) { %>aria-current="page"<% } %>>판매순위</a>
    <a href="${pageContext.request.contextPath}/app/admin/returns"
   <% if ("returns".equals(request.getAttribute("adminSection"))) { %>
       aria-current="page"
   <% } %>>
    반품·환불 관리
</a>
</nav>
