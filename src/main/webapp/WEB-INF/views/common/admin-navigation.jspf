<%@ page pageEncoding="UTF-8" %>
<%
    String[][] adminMenu = {
        {"dashboard", "대시보드"}, {"categories", "카테고리 관리"}, {"products", "상품 관리"},
        {"inventory", "온라인 재고"}, {"stores", "매장별 재고"}, {"orders", "주문 관리"}, {"users", "사용자 관리"}
    };
%>
<nav class="admin-sidebar" aria-label="관리 메뉴">
    <% for (String[] entry : adminMenu) { %>
        <a href="${pageContext.request.contextPath}/admin/?view=<%= entry[0] %>" data-admin-link="<%= entry[0] %>"<% if (entry[0].equals(request.getAttribute("adminSection"))) { %> aria-current="page"<% } %>><%= entry[1] %></a>
    <% } %>
</nav>
