<%@ page pageEncoding="UTF-8" %>
<header class="admin-header">
    <a href="${pageContext.request.contextPath}/admin/" class="admin-brand" aria-label="다이소 관리자 홈">
        <img src="${pageContext.request.contextPath}/assets/images/home/daiso-logo.svg" alt="" width="136" height="33">
        <span>관리자</span>
    </a>
    <span>체험용 관리자 · 실제 운영 시스템이 아닙니다</span>
    <%-- ===== 엑셀 다운로드 버튼은 이 공통 헤더 한 곳에서만 표시 ===== --%>
    <%
        String headerExcelUrl = daiso.admin.report.AdminExcelController.downloadUrl(request);
    %>
    <div class="admin-header-actions">
        <% if (headerExcelUrl != null) { %>
            <a class="admin-excel-link"
               href="<%= daiso.product.controller.ProductView.escape(headerExcelUrl) %>">
                <span class="admin-excel-icon" aria-hidden="true">↓</span>
                <span>엑셀 다운로드</span>
            </a>
        <% } %>
        <%@ include file="admin-chat.jspf" %>
        <a href="${pageContext.request.contextPath}/">고객 화면 보기 ↗</a>
    </div>
</header>
