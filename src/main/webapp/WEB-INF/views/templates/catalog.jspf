<%@ page pageEncoding="UTF-8" %>
<%-- Static markup; JavaScript clones these views and binds Mock data. --%>
<template id="view-catalog-breadcrumbs"><nav class="breadcrumbs" aria-label="현재 위치"></nav></template>
<template id="view-catalog-span"><span>›</span></template>
<template id="view-catalog-page-title"><h1 class="page-title"></h1></template>
<template id="view-catalog-category-chips"><nav class="category-chips" aria-label="하위 카테고리"></nav></template>
<template id="view-catalog-p-4"><p></p></template>
<template id="view-catalog-layout">
    <div class="catalog-layout">
        <form class="catalog-filter">
            <h2>상품 필터</h2>
            <label class="field">최대 가격<select name="maxPrice">
                <option value="">전체 가격</option><option value="1000">1,000원 이하</option><option value="3000">3,000원 이하</option><option value="5000">5,000원 이하</option>
            </select></label>
            <label class="check-field"><input type="checkbox" name="available"><span>구매 가능한 상품만</span></label>
            <button type="button" class="text-button" data-reset-filter>필터 초기화</button>
        </form>
        <section class="catalog-products">
            <div class="catalog-toolbar"><p class="result-count"></p><label class="sort-label">정렬 <select name="sort">
                <option value="recommended">추천순</option><option value="newest">신상품순</option><option value="priceAsc">가격낮은순</option><option value="priceDesc">가격높은순</option><option value="rating">별점순</option>
            </select></label></div>
            <div class="product-grid catalog-grid"></div>
            <button type="button" class="button secondary load-more">상품 더 보기</button>
        </section>
    </div>
</template>

<template id="view-product-detail"><div class="product-detail-layout">
    <img class="detail-image">
    <section class="detail-info">
        <p class="eyebrow" data-product="brand"></p><h1 class="page-title" data-product="name"></h1><p class="detail-price" data-product="price"></p>
        <p data-product="rating"></p><p class="source-note" data-product="source"></p><p data-product="id"></p><p class="stock-status" data-product="stock"></p>
        <div class="delivery-summary"><strong>택배배송</strong><p>배송비 3,000원 · 상품 30,000원 이상 무료</p></div>
        <details class="store-stock"><summary>체험 매장 재고 보기</summary></details>
        <label class="field">수량<input type="number" name="quantity" min="1" value="1"></label><p class="detail-total"></p><button type="button" class="button primary" data-add-cart>장바구니 담기</button>
    </section>
</div></template>
<template id="view-product-description"><section class="product-description"><h2>상품 설명</h2><p data-product-description></p><details><summary>상품 정보 및 반품 안내</summary><p>본 화면은 학습용 Mock입니다. 제조·인증·반품 정책은 실제 구매 정보가 아니며 백엔드 연동 전 별도 확정합니다.</p></details></section></template>
